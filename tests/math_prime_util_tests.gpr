with "config/math_prime_util_tests_config.gpr";
with "math_prime_util.gpr";
with "aunit.gpr";
project Math_Prime_Util_Tests is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Math_Prime_Util_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("test_runner.adb");

   package Compiler is
      for Default_Switches ("Ada") use Math_Prime_Util_Tests_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Math_Prime_Util_Tests;
